{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base", ":dependencyDashboard"
  ],
  "rangeStrategy": "widen",
  "forkProcessing": "enabled",
  "packageRules": [
    {
      "matchPackageNames": ["amphp/amp", "amphp/byte-stream", "amphp/phpunit-util"],
      "groupName": "amphp"
    },
    {
      "matchPackagePrefixes": ["phpunit/", "sebastian/", "brianium/"],
      "groupName": "phpunit"
    }
  ]
}
